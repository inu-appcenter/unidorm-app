{
  "cli": {
    "version": ">= 21.5.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "channel": "development",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_ROOT_URL": "https://unidorm-test.pages.dev"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_ROOT_URL": "https://unidorm.inuappcenter.kr"
      }
    }
  }
}
